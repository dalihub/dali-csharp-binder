# Package Information for pkg-config

prefix=@PREFIX@
exec_prefix=@EXEC_PREFIX@
apiversion=@DALI_CSHARP_BINDER_VERSION@
libdir=@LIB_DIR@
includedir=@DEV_INCLUDE_PATH@

Name: DALi C# binder
Description: DALi C# binder Libaray
Version: ${apiversion}
Requires: dali@DALI_API_MAJOR@-core dali@DALI_API_MAJOR@-adaptor dali@DALI_API_MAJOR@-toolkit dali@DALI_API_MAJOR@-scene3d
Libs: -L${libdir} -l@name@
Cflags: -I${includedir}/dali-csharp-binder
